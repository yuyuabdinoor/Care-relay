# Copy this file to .env. Never commit the resulting .env file.

# Prefer a named AWS CLI profile instead of storing access keys in this file.
AWS_PROFILE=care-relay-bedrock
AWS_REGION=us-east-1

# Strands' documented default and our explicit MVP model.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Local development defaults
CARE_RELAY_ENV=development
CARE_RELAY_LOG_LEVEL=INFO

# Optional final-demo integration. Use a dedicated synthetic calendar and keep
# the service-account JSON outside this repository.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/care-relay-calendar.json
# CARE_RELAY_GOOGLE_CALENDAR_ID=your-demo-calendar-id@group.calendar.google.com
# CARE_RELAY_GOOGLE_FOLLOW_UP_EVENT_ID=the-event-id-returned-by-setup
